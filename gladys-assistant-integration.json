            "de": "Tage bis zur APK",
            "es": "Días hasta la APK"
          }
        },
        {
          "key": "insured",
          "type": "boolean",
          "label": {
            "en": "Insured (WAM)",
            "fr": "Assuré (WAM)",
            "de": "Versichert (WAM)",
            "es": "Asegurado (WAM)"
          }
        },
        {
          "key": "open_recall",
          "type": "boolean",
          "label": {
            "en": "Open recall",
            "fr": "Rappel ouvert",
            "de": "Offener Rückruf",
            "es": "Revisión abierta"
          }
        },
        {
          "key": "alerts",
          "type": "number",
          "label": {
            "en": "Things needing attention",
            "fr": "Points à surveiller",
            "de": "Punkte, die Beachtung erfordern",
            "es": "Puntos que requieren atención"
          }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "vehicles",
      "label": {
        "en": "RDW vehicles",
        "fr": "Véhicules RDW",
        "de": "RDW-Fahrzeuge",
        "es": "Vehículos RDW"
      },
      "description": {
        "en": "APK, insurance and recalls of your vehicles, with what needs attention first.",
        "fr": "APK, assurance et rappels de vos véhicules, avec ce qui demande attention en premier.",
        "de": "APK, Versicherung und Rückrufe deiner Fahrzeuge, das Dringende zuerst.",
        "es": "APK, seguro y revisiones de tus vehículos, con lo urgente primero."
      },
      "icon": "truck",
      "settings": [
        {
          "key": "vehicle",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "One vehicle only",
            "fr": "Un seul véhicule",
            "de": "Nur ein Fahrzeug",
            "es": "Un solo vehículo"
          },
          "description": {
            "en": "Leave empty to list every vehicle.",
            "fr": "Laissez vide pour lister tous les véhicules.",
            "de": "Leer lassen, um alle Fahrzeuge aufzulisten.",
            "es": "Déjalo vacío para listar todos los vehículos."
          },
          "required": false
        },
        {
          "key": "only_alerts",
          "type": "boolean",
          "label": {
            "en": "Only what needs attention",
            "fr": "Seulement ce qui demande attention",
            "de": "Nur, was Beachtung erfordert",
            "es": "Solo lo que requiere atención"
          },
          "required": false,
          "default": false
        }
      ],
      "action_timeout_seconds": 30
    }
  ]
